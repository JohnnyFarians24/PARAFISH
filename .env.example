DB_SILVA_PATH=/data/silva/SILVA_138.2_SSURef_NR99_tax_silva_trunc.fasta.gz
# Optional: SILVA rank file (tax_slv_ssu_<release>.txt.gz). Unset = SILVA gives domain + organism only.
# DB_SILVA_RANKS_PATH=/data/silva/tax_slv_ssu_138.2.txt.gz
DB_PR2_PATH=/data/pr2/pr2_version_5.1.1_SSU_mothur.fasta.gz
DB_BOLD_PATH=/data/bold_db
DB_BLAST_PATH=/data/blast_db/nt

BOLD_USERNAME=
BOLD_PASSWORD=

RUNS_DIR=/data/runs

ENABLE_NCBI=False
ENABLE_BOLD=True
ENABLE_SILVA=True
ENABLE_PR2=True

GLOBAL_DB_ROOT=/data/dbs
ALLOW_DB_AUTO_DOWNLOAD=0
KEEP_INTERMEDIATES=0
NCBI_REMOTE_FALLBACK=1

# Smallest cluster allowed to SEED an OTU (vsearch --minuniquesize).
# 1 (default) keeps singletons: on a parasite-detection platform the globally-unique,
# >3%-divergent read is a rare taxon, not an error — errors sit within 3% of their parent
# and are absorbed by clustering either way. Verified: a floor of 2 was silently dropping
# a 1-read Melanogrammus aeglefinus hit at 100% identity.
# 2 buys clustering time on a large host-dominated study; its cost is visible as
# `unmapped_reads` in read_tracking.csv rather than silent.
PARAFISH_MIN_UNIQUE_SIZE=1
# Drop reads with no primer match (provenance, not signal). 1=on (default), 0=off.
PARAFISH_DISCARD_UNTRIMMED=1

# Use a LOCAL BLAST database instead of NCBI's public remote nt. Off by default: the
# public remote is the source the supervisors asked for and the one a reviewer can
# reproduce. Turn this on only as an emergency exit when NCBI is down — it also enables
# the sensitive search (task=blastn, word_size=11) that the public quota refuses with
# SIGXCPU, since a local db runs on your own CPU. Requires DB_BLAST_PATH.
PARAFISH_NCBI_LOCAL_DB=0
